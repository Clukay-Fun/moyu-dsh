{
  "name": "moyu-dsh",
  "version": "0.1.0",
  "description": "MOYU DSH 是一款基于 DeepSeek Harness 的原生桌面应用。",
  "author": "Clukay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/dsh-credentials-desktop",
    "packages/dsh-host-directory-picker-fixed",
    "packages/dsh-plugin-session-export",
    "packages/dsh-host-directory-picker-native",
    "packages/dsh-plugin-image",

    "packages/dsh-plugin-pdf",
    "packages/dsh-plugin-screenshot",
    "packages/dsh-plugin-scheduled-tasks",
    "packages/dsh-plugin-media",
    "packages/dsh-profile"
  ],
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:native:mac": "node scripts/build-macos-native.mjs",


    "build:mac": "npm run build:dsh-runtime && npm run apply-codex-web-overlay && npm run patch-upstream-brand && npm run verify-overlay-applied && npm run build:native:mac && npm run build && electron-builder --mac dmg --arm64",
    "verify:dsh-fence": "node scripts/verify-dsh-fence.mjs",
    "verify:dsh-bridge": "electron scripts/verify-dsh-bridge.mjs",
    "preview": "electron-vite preview",
    "build:dsh-runtime": "node scripts/build-dsh-runtime.mjs",
    "apply-codex-web-overlay": "node scripts/apply-codex-web-overlay.mjs",
    "patch-upstream-brand": "node scripts/patch-upstream-brand.mjs",
    "verify-overlay-applied": "node tests/verify-overlay-applied.mjs"
  },
  "build": {
    "appId": "com.clukay.moyutools",
    "productName": "MOYU",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "licenses/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },

      {
        "from": "resources/dsh-host-worker.mjs",
        "to": "workers/dsh-host-worker.mjs"
      },
      {
        "from": "resources/dsh-auth-fence.mjs",
        "to": "workers/dsh-auth-fence.mjs"
      }
    ],

    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "MOYU-v${version}-macOS-${arch}.${ext}",
      "icon": "assets/app-icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "MOYU DSH 需要读取屏幕以完成区域截图。"
      },
      "extraResources": [
        {
          "from": "build/macos/screen-capture",
          "to": "native/macos/screen-capture"
        },
        {
          "from": "assets/app-icon.png",
          "to": "app-icon.png"
        }
      ]
    },
    "afterPack": "scripts/after-pack-dsh-runtime.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-static": "^1.30.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "qpdf-run": "0.2.1",
    "sharp": "0.35.3"
  }
}

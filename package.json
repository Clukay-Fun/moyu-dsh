{
  "name": "moyu-tools",
  "version": "2.1.0",
  "description": "面向设计工作流的 Windows Electron 工具箱",
  "author": "Clukay",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:icon": "node scripts/generate-icon.mjs",
    "build:native:mac": "node scripts/build-macos-native.mjs",
    "build:tools:win": "powershell -ExecutionPolicy Bypass -File scripts/download-ffmpeg-win.ps1",
    "build:win": "npm run build:icon && npm run build:tools:win && npm run build && electron-builder --win portable --x64",
    "build:mac": "npm run build:dsh-runtime && npm run build:native:mac && npm run build && electron-builder --mac dmg --arm64",
    "verify:dsh-fence": "node scripts/verify-dsh-fence.mjs",
    "verify:dsh-bridge": "electron scripts/verify-dsh-bridge.mjs",
    "preview": "electron-vite preview",
    "build:dsh-runtime": "node scripts/build-dsh-runtime.mjs"
  },
  "build": {
    "appId": "com.clukay.moyutools",
    "productName": "摸鱼工具箱",
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/winax/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "licenses/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "resources/com-worker.cjs",
        "to": "workers/com-worker.cjs"
      },
      {
        "from": "resources/dsh-host-worker.mjs",
        "to": "workers/dsh-host-worker.mjs"
      },
      {
        "from": "resources/dsh-auth-fence.mjs",
        "to": "workers/dsh-auth-fence.mjs"
      },
      {
        "from": "resources/onboarding.html",
        "to": "onboarding.html"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "build/ffmpeg",
          "to": "tools/ffmpeg"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        },
        {
          "from": "assets/app-icon.png",
          "to": "app-icon.png"
        }
      ],
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Moyu-Tools-v${version}-Windows-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "Moyu-Tools-v${version}-macOS-${arch}.${ext}",
      "icon": "build/macos/app-icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "摸鱼工具箱需要读取屏幕以完成区域截图。"
      },
      "extraResources": [
        {
          "from": "build/macos/screen-capture",
          "to": "native/macos/screen-capture"
        },
        {
          "from": "assets/app-icon.png",
          "to": "app-icon.png"
        }
      ]
    },
    "afterPack": "scripts/after-pack-dsh-runtime.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-static": "^1.30.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "fabric": "5.5.2-browser",
    "gs1encoder": "1.4.1",
    "jsbarcode": "3.12.3",
    "opentype.js": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "qpdf-run": "0.2.1",
    "sharp": "0.35.3",
    "tesseract.js": "7.0.0"
  },
  "optionalDependencies": {
    "winax": "3.6.9"
  }
}

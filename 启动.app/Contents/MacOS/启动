#!/usr/bin/env bash
# Finder 双击启动入口：静默复用项目的 run.sh，日志留给排错使用。
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
LOG_FILE="${TMPDIR:-/tmp}/moyu-tools-launch.log"

"$ROOT_DIR/run.sh" >"$LOG_FILE" 2>&1
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
  osascript -e 'display alert "摸鱼工具箱未能启动" message "请使用 启动.command 查看错误，或检查 /tmp/moyu-tools-launch.log" as critical'
fi
